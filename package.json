{
  "name": "python-from-hell-rpg",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "verify": "node scripts/validate-content.mjs",
    "prepare:voice": "node scripts/voice/generate-voice-pack.mjs",
    "voice:install": "powershell -ExecutionPolicy Bypass -File .\\scripts\\voice\\download-piper-voices.ps1",
    "voice:generate": "powershell -ExecutionPolicy Bypass -File .\\scripts\\voice\\generate-voice-pack.ps1",
    "voice:mp3": "powershell -ExecutionPolicy Bypass -File .\\scripts\\voice\\convert-wav-to-mp3.ps1",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "motion": "^13.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^7.1.0",
    "@eslint/js": "^9.35.0",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^6.1.1",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^3.2.4"
  }
}
